+
+// attract-mode-cores: lockstep trace (M1TRACE_LOG). Records: u8 type, u32
+// payload bytes, payload. 0x10 write / 0x11 read: u64 count, u32 addr,
+// u32 data, u8 size, u8 space (0 program, 1 I/O). 0x30 interrupt: u64 count,
+// u32 vector, u32 PC. 0x01 sample (after each write to the IRQ control
+// register E00000): u64 count, u32 r0-r31, PC, PSW, then u8 n and per region
+// u32 base, u32 bytes, u64 FNV-1a-64 over its 32-bit words.
+void v60_device::trace_rec(uint8_t type, const void *p, uint32_t n)
+{
+	fwrite(&type, 1, 1, m_trace);
+	fwrite(&n, 4, 1, m_trace);
+	fwrite(p, 1, n, m_trace);
+}
+
+void v60_device::trace_access(int is_write, int sp, offs_t a, u32 v, int size)
+{
+	if (!m_trace || machine().side_effects_disabled())
+		return;
+	a &= 0xffffff;
+	if (sp == 0 && !m_dev_page[a >> 16])
+		return;
+	uint8_t b[18];
+	memcpy(b, &m_insn_count, 8);
+	memcpy(b + 8, &a, 4);
+	memcpy(b + 12, &v, 4);
+	b[16] = uint8_t(size);
+	b[17] = uint8_t(sp);
+	trace_rec(is_write ? 0x10 : 0x11, b, sizeof b);
+	if (is_write && sp == 0 && a == 0xe00000)
+		trace_sample();
+}
+
+void v60_device::trace_sample()
+{
+	static const uint32_t regions[][2] = {
+		{ 0x400000, 0x10000 }, { 0x500000, 0x40000 }, { 0x600000, 0x20000 }, { 0x700000, 0x10000 },
+		{ 0x780000, 0x80000 }, { 0x900000, 0x4000 }, { 0x910000, 0xc000 } };
+	std::vector<uint8_t> b(8 + 34 * 4 + 1 + std::size(regions) * 16);
+	uint8_t *p = b.data();
+	memcpy(p, &m_insn_count, 8); p += 8;
+	memcpy(p, m_reg, 32 * 4); p += 32 * 4;
+	uint32_t pc = PC, psw = v60ReadPSW();
+	memcpy(p, &pc, 4); memcpy(p + 4, &psw, 4); p += 8;
+	*p++ = uint8_t(std::size(regions));
+	auto &mem = *m_program;
+	for (auto &r : regions)
+	{
+		uint64_t h = 0xcbf29ce484222325ULL;
+		for (uint32_t o = 0; o < r[1]; o += 4)
+			h = (h ^ mem.read_dword(r[0] + o)) * 0x100000001b3ULL;
+		memcpy(p, &r[0], 4); memcpy(p + 4, &r[1], 4); memcpy(p + 8, &h, 8); p += 16;
+	}
+	trace_rec(0x01, b.data(), uint32_t(b.size()));
+}
+
+void v60_device::device_stop()
+{
+	if (m_trace)
+	{
+		uint32_t b[2] = { uint32_t(m_insn_count), uint32_t(m_insn_count >> 32) };
+		trace_rec(0x7f, b, sizeof b);
+		fclose(m_trace);
+		m_trace = nullptr;
+	}
+	if (m_pc_log)
+	{
+		fclose(m_pc_log);
+		m_pc_log = nullptr;
+	}
+	if (!m_pc_seen.empty())
+	{
+		// every instruction address executed, one hex address per line
+		FILE *f = fopen(m_pc_seen_path.c_str(), "w");
+		if (f)
+		{
+			for (size_t i = 0; i < m_pc_seen.size(); i++)
+				for (int b = 0; b < 64; b++)
+					if (m_pc_seen[i] >> b & 1)
+						fprintf(f, "%06x\n", unsigned(i * 64 + b));
+			fclose(f);
+		}
+	}
+}
